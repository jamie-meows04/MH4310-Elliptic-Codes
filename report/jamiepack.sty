% Box styles. Each takes two arguments: {<background>}{<text>}.
% The background colour fills the box (and the banner); the text colour is
% used for the title, the frame, and all other lines. Body text stays black.

% Title of a claimstyle box. \jp@description is only called when the box has
% a description; it switches the end of the title from a run-in dot to a
% line break.
\makeatletter
\newcommand{\jp@titledot}{{\color{tcbcoltitle}\bfseries\sffamily.}\ }
\newcommand{\jp@titlebreak}{\par\medskip}
\newcommand{\jp@description}[1]{%
	\global\let\jp@aftertitle\jp@titlebreak
	{\mdseries(#1)}%
}
\newcommand{\jp@claimtitle}{%
	\global\let\jp@aftertitle\jp@titledot
	\tcbtitle\jp@aftertitle
}

\tcbuselibrary{theorems,skins,hooks,breakable}
\tcbset{%
	% Framed box with the title in a banner on the top edge
	defnstyle/.style 2 args={%
		breakable,
		enhanced,
		before skip=12pt,
		after skip=12pt,
		colback=#1,
		colframe=#2,
		coltitle=#2,
		boxrule=0.8pt,
		attach boxed title to top left={xshift=1cm,yshift*=1mm-\tcboxedtitleheight},
		varwidth boxed title*=-3cm,
		boxed title style={
			frame code={
				\path[draw=#2, line width=0.8pt]
				([yshift=-1mm,xshift=-1.1mm]frame.north west)
				arc[start angle=0,end angle=180,radius=1mm]
				([yshift=-1mm,xshift=1.1mm]frame.north east)
				arc[start angle=180,end angle=0,radius=1mm];
				\path[fill=#1, draw=#2, line width=0.8pt]
				([xshift=-2mm]frame.north west) -- ([xshift=2mm]frame.north east)
				[rounded corners=1mm]-- ([xshift=1mm,yshift=-1mm]frame.north east)
				-- (frame.south east) -- (frame.south west)
				-- ([xshift=-1mm,yshift=-1mm]frame.north west)
				[sharp corners]-- cycle;
			},
			interior engine=empty,
		},
		fonttitle=\bfseries,
		description font=\mdseries,
		description delimiters parenthesis,
		separator sign none,
		segmentation style={solid, #2},
	},
	% Unframed box with a rule on the left. Without a description, the title
	% runs into the body ("Theorem 3. ..."); with one, the title is on its own
	% line ("Theorem 3 (Name)", then the body).
	claimstyle/.style 2 args={%
		breakable,
		enhanced,
		before skip=12pt,
		after skip=12pt,
		colback=#1,
		coltitle=#2,
		frame hidden,
		boxrule=0sp,
		borderline west={2.5pt}{0pt}{#2},
		sharp corners,
		detach title,
		before upper=\jp@claimtitle,
		fonttitle=\bfseries\sffamily,
		description formatter=\jp@description,
		separator sign none,
		segmentation style={solid, #2},
	},
	% Framed box with square corners (not used by \claimbox)
	examplestyle/.style 2 args={%
		breakable,
		enhanced,
		before skip=16pt,
		after skip=16pt,
		colback=#1,
		colframe=#2,
		coltitle=#2,
		boxrule=0.5pt,
		sharp corners,
		detach title,
		before upper=\tcbtitle\par\medskip,
		fonttitle=\bfseries\sffamily,
		description font=\mdseries,
		separator sign none,
		description delimiters parenthesis,
	},
}
\makeatother

