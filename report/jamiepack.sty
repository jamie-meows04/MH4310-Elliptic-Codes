% {{{ PERSONAL STYLING

% Font
\loadfont
\renewcommand{\textbf}[1]{%
	\textcolor{deepestblue}{\bfseries{#1}}%
}

% General Formatting
\flushbottom
\widowpenalty=0
\clubpenalty=0
\interlinepenalty=0
\predisplaypenalty=0
\displaywidowpenalty=0
\setlength{\columnsep}{0.6cm}
\setlength{\parindent}{0pt}
\setlength{\parskip}{1em plus 1em minus 0.5em}
\renewcommand{\baselinestretch}{1.2}
\renewcommand{\arraystretch}{1.1}
\newcommand{\mycomment}[1]{}
\newcommand{\hrulebar}{%
	\begin{center}
		\par\hspace*{\fill}\rule{0.8\textwidth}{.7pt}\hspace*{\fill}%
		% \par\noindent\rule{\textwidth}{0.7pt}%
		\par\nointerlineskip \vspace{\baselineskip}%
	\end{center}
}
\newcommand{\boxsc}[1]{\boxed{\textsc{#1}}}

% Math Formatting
\setmathstyle
\mleftright
\let\l\mleft
\let\r\mright
\newcolumntype{M}{>{$}c<{$}}
\allowdisplaybreaks
\AtBeginDocument{
    \addtolength{\abovedisplayskip}{-0.75ex}
    \addtolength{\abovedisplayshortskip}{-0.75ex}
    \addtolength{\belowdisplayskip}{-0.75ex}
    \addtolength{\belowdisplayshortskip}{-0.75ex}
}

% List Formatting
\setlist{topsep=-5pt, itemsep=-5pt, left=0pt, beginpenalty=0, midpenalty=0, endpenalty=0}
\setlist[enumerate,1]{label={\arabic*.}}
\setlist[enumerate,2]{label=\alph*.}
\setlist[itemize,2]{label=$\diamond$}

% Title formatting
\setlength{\droptitle}{-2cm}
\author{\textsc{Jamie Low Jiaqi}}
\date{}

\newcommand{\ToC}{\tableofcontents\restoregeometry}

% Section formatting
\newcommand{\usubsection}[1]{\subsection*{#1}\addcontentsline{toc}{subsection}{#1}}
\newcommand{\usection}[1]{\section*{#1}\addcontentsline{toc}{section}{#1}\markright{\footnotesize\textbf{#1}}}
\newcommand{\uchapter}[1]{\chapter*{#1}\addcontentsline{toc}{chapter}{#1}}

% Footnote formatting
\let\oldfootnote\footnote
\renewcommand\footnote[1]{%
	\oldfootnote{\hspace{1mm}#1}%
}
\setlength{\footnotesep}{10.8pt}
\interfootnotelinepenalty=10000

% Equations, figures, tables and captions

\makeatletter

\newcounter{eqn}
\newcommand{\eqlabel}[1]{\refstepcounter{eqn}\tag{\theeqn}\label{#1}}

\crefname{figure}{figure}{figures}
\Crefname{figure}{Figure}{Figures}
\crefname{table}{table}{tables}
\Crefname{table}{Table}{Tables}

\let\oldfigure\figure
\renewcommand{\figure}{\oldfigure[ht]\centering\refstepcounter{tcb@cnt@definition}}
\newcommand{\figcaption}{\par\smallskip\small\textbf{Figure \thetcb@cnt@definition.}\ }
\newcommand{\tabcaption}{\par\medskip\small\textbf{Table \thetcb@cnt@definition.}\ }

\let\oldprintbibliography\printbibliography
\renewcommand{\printbibliography}{\usection{References}\oldprintbibliography[heading=none]}

\newenvironment{Tabular}[2][1.1]{\begingroup\renewcommand{\arraystretch}{#1}\tabular{#2}}{\endtabular\endgroup}

\makeatother

