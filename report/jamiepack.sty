% \claimbox[<banner>]{<background>}{<text>}{<environment>}{<Name>}{<Names>}
%
% <banner>       true: defnstyle (title in a banner);
%                false (default): claimstyle
% <background>   light colour, used only for the background
% <text>         dark colour, used for the title and all lines
% <environment>  environment name and label prefix
% <Name>         title of the box, and the singular name for \cref and \Cref
% <Names>        plural name for \cref and \Cref
%
% With the boxbw option, the colours are overridden by white and black.
%
% For example,
%   \claimbox{Azure}{Navy}{theorem}{Theorem}{Theorems}
% defines \begin{theorem}{<description>}{<label>}, referenced as
% theorem:<label>, which \cref and \Cref both print as "Theorem".
\makeatletter
\NewDocumentCommand{\claimbox}{O{false} m m m m m}{%
	\ifbububoxbw
		\jp@claimbox{#1}{white}{black}{#4}{#5}{#6}%
	\else
		\jp@claimbox{#1}{#2}{#3}{#4}{#5}{#6}%
	\fi
}
\newcommand{\jp@claimbox}[6]{%
	\ifthenelse{\equal{#1}{true}}%
		{\jp@newbox{defnstyle}{#2}{#3}{#4}{#5}{#6}}%
		{\jp@newbox{claimstyle}{#2}{#3}{#4}{#5}{#6}}%
}
% \jp@newbox{<style>}{<bg>}{<text>}{<environment>}{<Name>}{<Names>}
\newcommand{\jp@newbox}[6]{%
	\newtcbtheorem[
		use counter from=base,
		crefname={#5}{#6},
		Crefname={#5}{#6},
	]{#4}{#5}{%
		#1={#2}{#3},
		title={#5},
	}{#4}%
}
\makeatother

