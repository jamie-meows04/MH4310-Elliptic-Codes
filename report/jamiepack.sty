		boxed title style={%
			colback=noteboxcolback,
			size=fbox,
			boxrule=1pt,
			boxsep=2pt,
			underlay={%
				\coordinate (dotA) at ($(interior.west) + (-0.5pt,0)$);
				\coordinate (dotB) at ($(interior.east) + (0.5pt,0)$);
				\begin{scope}%
					\clip (interior.north west) rectangle ([xshift=3ex]interior.east);
					\filldraw [noteboxfill, blur shadow={shadow opacity=60, shadow
						yshift=-.75ex}, rounded corners=2pt] (interior.north west)
					rectangle (interior.south east);
				\end{scope}
				\begin{scope}[noteboxscope]%
					\fill (dotA) circle (2pt);
					\fill (dotB) circle (2pt);
				\end{scope}
			},
		},
	}
}

